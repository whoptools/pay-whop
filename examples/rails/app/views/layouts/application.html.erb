<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Try Whop payments in a real Rails app. Hosted checkout, signed webhooks and subscription controls, powered by the community pay-whop gem.">
    <title>Pay Whop · Rails payment playground · WhopTools</title>
    <%= csrf_meta_tags %>
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)"><meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)">
    <link rel="stylesheet" href="<%= WhopTools::KIT_CSS %>">
    <link rel="stylesheet" href="<%= WhopTools::PLAYGROUND_CSS %>">
  </head>
  <body class="wt-body">
    <a class="wt-skip" href="#main">Skip to playground</a>
    <%# Shared WhopTools navigation, vendored from whoptools/whoptools.com. %>
    <%= WhopTools::HEADER %>
    <main id="main" class="wt-main">
      <div class="wt-container">
        <%= yield %>
        <section class="wt-section about" aria-labelledby="about-title">
          <h2 id="about-title">Privacy</h2>
          <p class="wt-muted">Encrypted 30-day session cookie. Stores a random demo identity and billing records; cards stay on Whop. No analytics.</p>
        </section>
      </div>
    </main>
    <%= WhopTools::FOOTER %>
  </body>
</html>
