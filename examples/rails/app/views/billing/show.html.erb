  <% if flash[:alert] %><div class="notice" role="alert"><%= flash[:alert] %></div><% end %>
  <% if flash[:recovery_url].present? %><p><%= link_to "Complete test payment authentication on Whop", flash[:recovery_url], class: "wt-button wt-button--surface wt-button--sm" %></p><% end %>
  <section class="hero" aria-labelledby="hero-title">
    <div>
      <p class="wt-eyebrow">Pay Whop · Rails <span class="wt-badge wt-badge--warning">Sandbox · no real money</span></p>
      <h1 id="hero-title" class="wt-title">Whop payments for Rails.</h1>
      <p class="wt-lead">Checkout, subscriptions, refunds and marketplace fees through the Pay gem. Signed webhooks keep Rails in sync.</p>
      <% if @customer %>
        <div class="wt-actions">
          <%= button_to "Subscription checkout →", checkout_path, class: "wt-button wt-button--solid" %>
          <%= button_to "$5 one-time purchase", checkout_path(flow: "one_time"), class: "wt-button wt-button--surface" %>
          <% if @marketplace_enabled %><%= button_to "$5 marketplace purchase", checkout_path(flow: "marketplace"), class: "wt-button wt-button--surface" %><% end %>
          <%= button_to "Save a test payment method", checkout_path(flow: "setup"), class: "wt-button wt-button--surface" %>
        </div>
      <% else %>
        <div class="wt-actions"><%= button_to "Start your sandbox session →", start_session_path, class: "wt-button wt-button--solid" %><%= WhopTools::SOURCE_BUTTON %></div>
      <% end %>
      <p class="muted">Private session. Test cards only.</p>
    </div>
    <div class="code" aria-label="Ruby integration example">
      <p>YOUR RAILS APP / BILLING</p>
      <pre><code>user.set_payment_processor(:whop)

checkout = user.payment_processor.checkout(
  variant_id: "plan_...",
  redirect_url: billing_url
)

redirect_to checkout.purchase_url,
  allow_other_host: true

# After the verified webhook:
user.payment_processor.subscribed? # true</code></pre>
    </div>
  </section>
  <section id="simulations" class="panel simulation-panel" aria-labelledby="simulations-title">
    <p class="wt-badge wt-badge--warning simulation-label">Simulation · local data</p>
    <h2 id="simulations-title">Invoice and transfer simulations</h2>
    <p class="muted">No Whop account needed. These controls do not call Whop or move money, and don’t prove Whop supports the flow.</p>
    <% if @customer %>
      <div class="simulation-grid">
        <% DemoSimulation::FLOWS.each_key do |kind| %>
          <% simulation = @simulations[kind] %>
          <article class="simulation-card" aria-labelledby="simulation-<%= kind %>-title">
            <h3 id="simulation-<%= kind %>-title">Simulated <%= kind %></h3>
            <p class="muted"><%= kind == "invoice" ? "$5.00 USD · draft, issue, overdue, pay or void" : "$4.00 USD · platform → example seller · success or failure" %></p>
            <% if simulation %>
              <p><code><%= simulation.reference %></code></p>
              <p><strong>Simulated status: <%= simulation.status.humanize %></strong></p>
              <div class="actions">
                <% simulation.actions.each_key do |event| %>
                  <%= button_to DemoSimulation::LABELS.fetch(event), simulation_path(kind: kind, event: event), class: "wt-button wt-button--surface wt-button--sm" %>
                <% end %>
                <%= button_to "Reset #{kind} simulation", simulation_path(kind: kind, event: "reset"), class: "wt-button wt-button--surface wt-button--sm" %>
              </div>
              <h4>Simulated activity</h4>
              <ol class="simulation-history">
                <% simulation.history.each do |entry| %>
                  <li><%= entry.fetch("status").humanize %> · <time datetime="<%= entry.fetch("at") %>"><%= Time.iso8601(entry.fetch("at")).utc.strftime("%d %b %Y, %H:%M:%S UTC") %></time></li>
                <% end %>
              </ol>
            <% else %>
              <%= button_to "Start #{kind} simulation", simulation_path(kind: kind, event: "start"), class: "wt-button wt-button--surface wt-button--sm" %>
            <% end %>
          </article>
        <% end %>
      </div>
    <% else %>
      <%= button_to "Start a session to try simulations", start_session_path, class: "wt-button wt-button--surface wt-button--sm" %>
    <% end %>
  </section>
  <section class="steps" aria-label="How to try the demo">
    <div><div class="step-number">01 / CHECK OUT</div><h3>Pay with a test card</h3><p class="muted">Hosted Whop checkout, sandbox account.</p></div>
    <div><div class="step-number">02 / SYNC</div><h3>Webhook syncs Rails</h3><p class="muted">Signed, verified, written to Pay.</p></div>
    <div><div class="step-number">03 / EXPLORE</div><h3>Manage billing</h3><p class="muted">Pause, cancel, resume, refund. Marketplace adds a $1 fee.</p></div>
  </section>
  <section class="panel" aria-labelledby="billing-title">
    <div class="panel-head"><div><h2 id="billing-title">Your sandbox billing</h2><p class="muted"><%= @customer ? "Updates after Whop confirms each change." : "Start a session to get a test customer." %></p></div><%= link_to "Refresh status", root_path(anchor: "billing-title"), class: "wt-button wt-button--surface wt-button--sm" %></div>
    <h3 class="table-title">Subscriptions</h3>
    <% if @subscriptions.empty? %>
      <p class="empty">No confirmed subscription yet. Returning from checkout alone does not grant access.</p>
    <% else %>
      <p id="subscription-scroll-help" class="muted table-help">Scroll the table sideways to see every column.</p>
      <div class="table" tabindex="0" role="region" aria-label="Subscriptions" aria-describedby="subscription-scroll-help"><table><thead><tr><th scope="col">Subscription</th><th scope="col">State</th><th scope="col">Period ends</th><th scope="col">Action</th></tr></thead><tbody>
        <% @subscriptions.each do |subscription| %><tr>
          <td><code><%= subscription.processor_id %></code></td>
          <td class="status"><%= subscription.status.humanize %><%= " · billing paused" if subscription.paused? %><%= " · cancellation scheduled" if subscription.on_grace_period? %></td>
          <td><%= subscription.current_period_end&.strftime("%d %b %Y, %H:%M UTC") || "—" %></td>
          <td><% if subscription.resumable? %><%= button_to(subscription.paused? ? "Resume billing" : "Keep subscription", resume_subscription_path(subscription), class: "wt-button wt-button--surface wt-button--sm") %><% elsif subscription.active? %><div class="actions"><%= button_to "Cancel at period end", cancel_subscription_path(subscription), class: "wt-button wt-button--surface wt-button--sm" %><%= button_to "Pause billing", pause_subscription_path(subscription), class: "wt-button wt-button--surface wt-button--sm" %></div><% elsif %w[past_due incomplete].include?(subscription.status) %><%= button_to "Retry existing test payment", retry_subscription_path(subscription), class: "wt-button wt-button--surface wt-button--sm" %><% end %></td>
        </tr><% end %>
      </tbody></table></div>
    <% end %>
    <h3 class="table-title">Payments</h3>
    <% if @charges.empty? %><p class="empty">No successful payment yet.</p><% else %>
      <p id="payment-scroll-help" class="muted table-help">Scroll the table sideways to see every column.</p>
      <div class="table" tabindex="0" role="region" aria-label="Payments" aria-describedby="payment-scroll-help"><table><thead><tr><th scope="col">Payment</th><th scope="col">Paid</th><th scope="col">Refunded</th><th scope="col">Action</th></tr></thead><tbody>
        <% @charges.each do |charge| %><tr><td><code><%= charge.processor_id %></code><% if charge.customer.account_id != Pay::Whop.account_id %><br><small>Marketplace seller</small><% end %></td><td><%= charge.amount_with_currency %></td><td><%= charge.amount_refunded_with_currency %></td><td><% unless charge.full_refund? %><div class="actions"><%= button_to "Refund remaining amount", refund_charge_path(charge), class: "wt-button wt-button--surface wt-button--sm" %><% if charge.currency == "usd" && charge.amount - charge.amount_refunded.to_i > 100 %><%= button_to "Refund $1", refund_charge_path(charge, partial: "1"), class: "wt-button wt-button--surface wt-button--sm" %><% end %></div><% end %></td></tr><% end %>
      </tbody></table></div>
    <% end %>
    <p class="muted">Refunds can fail while sandbox funds are pending. Refunds don’t cancel subscriptions.</p>
  </section>
  <% if @customer&.processor_id.present? %>
    <section class="panel" aria-labelledby="saved-title">
      <h2 id="saved-title">Saved methods and invoices</h2>
      <p class="muted">One $5 saved-method charge and one draft invoice per session. Issuing invoices needs Whop verification.</p>
      <%= button_to "Refresh saved methods", sync_payment_methods_path, class: "wt-button wt-button--surface wt-button--sm" %>
      <p><%= button_to "Reconcile billing from Whop", reconcile_billing_path, class: "wt-button wt-button--surface wt-button--sm" %></p>
      <p class="muted">Reconcile pulls confirmed memberships, payments and invoices from Whop. It never charges.</p>
      <% @methods.each do |method| %><p><%= method.brand || method.payment_method_type %> ···· <%= method.last4 %></p><%= button_to "Charge $5 to this test method", saved_charge_path(payment_method_id: method.processor_id), class: "wt-button wt-button--surface wt-button--sm" %><% end %>
      <% if ENV["WHOP_ONE_TIME_VARIANT_ID"].present? %><p><%= button_to "Create a $5 draft invoice", create_invoice_path, class: "wt-button wt-button--surface wt-button--sm" %></p><% end %>
      <% @invoices.each do |invoice| %><p>Invoice <%= invoice.data["number"] || invoice.processor_id %> · <%= invoice.status.humanize %> <% if invoice.checkout_url.present? && URI.parse(invoice.checkout_url).host == "sandbox.whop.com" %>· <%= link_to "Open invoice", invoice.checkout_url %><% end %></p><% end %>
    </section>
  <% end %>
  <section class="details" aria-label="Test instructions and source code">
    <div class="panel"><h2>Your test card</h2><p class="test-card">4242 4242 4242 4242</p><p class="muted">Any future expiry · any CVC · fake billing details.</p><details><summary>Test declines and authentication</summary><p class="muted">Declined payment: <code>4000 0000 0000 0002</code><br>Save successfully, decline later charges: <code>4000 0000 0000 0341</code><br>3D Secure: <code>5385 3083 6013 5181</code> · enter <code>Checkout1!</code> on the authentication screen.</p></details><p class="muted">Sandbox money only.</p></div>
    <div class="panel"><h2>Use it in your app</h2><code class="wt-snippet">gem "pay-whop"</code><p class="muted">Alpha. No plan swaps, seat changes or metered billing yet.</p><p><%= WhopTools::SOURCE_BUTTON %></p></div>
  </section>
